# Copy this file to .env and fill in real values. Never commit .env!
PORT=5000
NODE_ENV=development

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Frontend URL(s) allowed to call the API, comma-separated (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Optional: custom SQLite file location (defaults to backend/database/edu.db)
# DB_PATH=/var/data/edu.db
